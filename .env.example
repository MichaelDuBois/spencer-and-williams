# Copy this file to `.env.local` and fill in real values.
# All variables are NEXT_PUBLIC_* (inlined at build time — restart/rebuild after changes).
# Algolia credentials are NOT here: they live in each vertical's config.ts (demo search-only keys).

# Mapbox token used by the travel map and store locators.
# Maps degrade gracefully without it.
NEXT_PUBLIC_MAPBOX_TOKEN=your_token_here

# Supabase project hosting the `extract-grocery-list` Edge Function
# (grocery "Import from photo"). Without these, that feature is disabled;
# the OpenAI key stays server-side in the function.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Filter Suggestions is hidden across all verticals by default.
# Set to `true` to bring back the widget and its demo-options toggle.
NEXT_PUBLIC_SHOW_FILTER_SUGGESTIONS=false

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Set the real value in .env.local (gitignored) and in your host's env for production.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Amplitude analytics + Session Replay API key. Set it only in the production host env;
# leave it empty locally so nothing initializes or sends events.
NEXT_PUBLIC_AMPLITUDE_API_KEY=